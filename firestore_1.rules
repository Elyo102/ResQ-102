rules_version = '2';

// =====================================================================
//  תחנה 102 — כללי אבטחה
//  גרסה 2.6 — מבוססת Custom Claims
//
//  מה השתנה מגרסה 1.1
//  -------------------
//  התפקיד נקרא מתוך טוקן ההזדהות, לא ממסמך ב-Firestore.
//  אין בקובץ הזה אף קריאת get() — אפס קריאות מסמך לכל בדיקת הרשאה.
//  בגרסה הקודמת כל פעולה עלתה 4-5 קריאות שגוגל מחייבת עליהן.
//
//  מקור האמת להרשאות: הטוקן.
//  המסמך ב-users הוא לתצוגה בלבד, ורק השרת כותב אליו.
//
//  מי כותב לטוקן: functions/index.js בלבד.
//
//  מלכודת שחוזרת: אחרי שינוי תפקיד או אימות מייל, הטוקן הישן עדיין
//  נושא את הערכים הקודמים. חובה getIdToken(true) בצד הלקוח.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- זהות ----------

    // אימות מייל ירד מהדרישה ב-22.8.2026, במודע.
    //
    // הוא נוסף כדי למנוע מצב שמישהו נרשם עם המייל של כבאי אחר
    // ויורש את תפקידו. מאז זה כבר לא אפשרי: אף אחד לא מקבל
    // תפקיד אוטומטית — רק מנהל-על מאשר, והתפקיד נכתב בשרת.
    //
    // להשאיר אותו היה מחייב כל כבאי לפתוח מייל ולאמת לפני שהוא
    // בכלל יכול להגיש בקשה — חיכוך בלי תמורה ביטחונית.
    //
    // המייל עדיין נדרש, ועדיין משמש לשחזור סיסמה.
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    // קריאת claim בבטחה. משתמש חדש שעוד לא קיבל תפקיד פשוט
    // יקבל מחרוזת ריקה, במקום שהכלל ייכשל בשגיאה.
    function claim(key) {
      return request.auth.token.get(key, '');
    }

    // הרשמה פתוחה לכל אחד, ולכן "מחובר" אינו "עובד". בלי ההבחנה
    // הזו כל אדם בעולם היה נרשם בכתובת חד-פעמית וקורא את ספריית
    // העובדים הארצית — שם, תפקיד, משמרת ותחנה של כל כבאי במדינה.
    //
    // מספר עובד קיים בטוקן רק אחרי אישור מנהל.
    function approved() {
      return signedIn() && claim('emp') != '';
    }

    // מנהל-על. שדה ה-super מגיע מהפונקציה bootstrapSuperAdmin.
    // בדיקת המייל היא רשת ביטחון: אם ה-claim נמחק בטעות,
    // מנהל המערכת עדיין יכול להיכנס ולתקן. חייב להיות זהה
    // לערך SUPER_ADMIN_EMAIL ב-functions/index.js.
    function isSuper() {
      return signedIn()
             && (request.auth.token.get('super', false) == true
                 || request.auth.token.email.lower() == 'fire102.shits@gmail.com');
    }

    // ---------- שיוך לתחנה ----------

    function inStation(sid) {
      return signedIn() && claim('stationId') == sid;
    }

    // סגן מפקד משמרת ומפקד תחנה, 23.8.2026.
    //
    // הסגן אינו הערה על מפקד — הוא תפקיד. אלדד חוזר בכל דרישה
    // על "מפקד משמרת או סגנו", ולכן סמכויותיו זהות, והוא נעול
    // לאותה משמרת בדיוק כמוהו.
    //
    // מפקד התחנה רואה את שלוש המשמרות, והוא היחיד שמאשר
    // ירידה מתחת לקו האדום.

    function member(sid) {
      return isSuper()
             || (inStation(sid)
                 && claim('role') in ['firefighter', 'deputy', 'commander',
                                      'station_commander', 'hr_coordinator']);
    }

    function staff(sid) {
      return isSuper()
             || (inStation(sid) && claim('role') in
                 ['deputy', 'commander', 'station_commander', 'hr_coordinator']);
    }

    // מפקד התחנה. השם הארוך במכוון — stationCmd מול commander
    // הם שני דברים שונים לגמרי, ושם דומה מדי היה מזמין טעות.
    function stationCommander(sid) {
      return isSuper()
             || (inStation(sid) && claim('role') == 'station_commander');
    }

    function hr(sid) {
      return isSuper() || (inStation(sid) && claim('role') == 'hr_coordinator');
    }

    // ---------- נעילת מפקד משמרת למשמרת שלו ----------
    //
    // מפקד משמרת ב' מנהל את ב'. הוא עדיין שואל אנשים מכל התחנה —
    // המאגר כלל-תחנתי — אבל הלוח שהוא עורך הוא שלו בלבד.
    //
    // רכז כוח אדם ומנהל-על אינם נעולים: תפקידם להשוות בין
    // משמרות ולסדר ביניהן.
    //
    // מי שאין לו שיוך משמרת אינו ננעל. אחרת מפקד שטרם שויך
    // היה חסום מכל שלוש המשמרות, בלי שום דרך לראות שזו הסיבה.
    function myShift() {
      return claim('shift');
    }

    function seesShift(sid, crew) {
      return isSuper() || hr(sid) || stationCommander(sid)
             || myShift() == '' || myShift() == crew;
    }

    // כמו seesShift, אבל על נתון שכבר קיים ושדה המשמרת שלו
    // עלול להיות ריק — רשומה ישנה, או אדם בלי שיוך. רשומה
    // בלי משמרת נראית לכל הסגל, כי אין לפי מה לנעול אותה,
    // ולנעול הכל היה מסתיר נתונים בלי שאיש יבין למה.
    function seesCrewData(sid, crew) {
      return isSuper() || hr(sid) || stationCommander(sid) || crew == ''
             || myShift() == '' || myShift() == crew;
    }

    // מספר עובד. המערכת מקצה אותו באישור ההרשמה, והוא מזהה
    // את הכבאי בכל הדיווחים שלו. הוא גם משמש כהגנה מפני זדון,
    // ולכן אינו גלוי לכבאים אחרים.
    function myEmp() {
      return claim('emp');
    }

    // מחוז. תחנת אילת שייכת למחוז דרום.
    //
    // ההיררכיה לא מקוננת בנתיב בכוונה: נתיב כמו
    // districts/{d}/stations/{s} היה נועל את השיוך, ומעבר תחנה
    // בין מחוזות היה דורש להזיז את כל הנתונים שלה.
    //
    // במקום זה המחוז הוא שדה על מסמך התחנה, ו-claim על המשתמש.
    // ההשוואה ביניהם לא עולה אף קריאת מסמך.
    function myDistrict() {
      return claim('districtId');
    }

    // הפונקציה מקבלת את המחוז כפרמטר ולא קוראת את resource.
    //
    // תוקן 22.8.2026 אחרי שהמהדר של Firebase סימן
    // "Invalid variable name: resource" — הגרסה הקודמת ניסתה
    // לקרוא את המסמך מתוך פונקציה כללית, ושם resource לא קיים.
    // הוא זמין רק בתוך כלל שמתייחס למסמך מסוים.
    function inDistrict(did) {
      return isSuper()
             || (signedIn()
                 && claim('role') == 'district_commander'
                 && myDistrict() != ''
                 && myDistrict() == did);
    }

    // ---------- בקשות הרשמה ----------
    //
    // עברו לשורש, לא תחת התחנה: משתמש חדש עדיין בלי שיוך, ולכן
    // אין לו דרך חוקית לכתוב לתוך נתיב של תחנה מסוימת.
    //
    // הכבאי ממלא שם, מייל, טלפון, מחוז ותחנה.
    // מספר עובד לא מוזן — המערכת מקצה אותו באישור.

    match /registration_requests/{uid} {
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.email == request.auth.token.email.lower()
                    && request.resource.data.status == 'pending';
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow read, write:  if isSuper();
    }


    // ---------- מפתח כניסה ומוני מערכת ----------
    // נקראים ונכתבים על ידי השרת בלבד. חסומים ללקוח לגמרי.

    match /emp_index/{emp} {
      allow read, write: if false;
    }

    match /login_attempts/{emp} {
      allow read, write: if false;
    }

    match /meta/{docId} {
      allow read, write: if false;
    }

    // תור המיילים היוצאים ואסימוני שחרור נעילה.
    // נכתבים על ידי השרת, נקראים על ידי תוסף השליחה. חסומים ללקוח.

    match /mail/{docId} {
      allow read, write: if false;
    }

    // יומן מיילים שנכשלו. נכתב בידי deliverMail אחרי שלושה ניסיונות.
    //
    // חסום ללקוח כמו mail עצמו: הוא מכיל כתובות ונושאי מייל, ואת
    // שגיאת ה-SMTP המלאה — שעלולה לחשוף פרטי שרת. המנהל רואה אותו
    // דרך פונקציית שרת, לא בקריאה ישירה.
    match /mail_failures/{docId} {
      allow read, write: if false;
    }

    match /unlock_tokens/{token} {
      allow read, write: if false;
    }

    // מצב שקט ויומן ההתראות שנחסמו.
    //
    // שניהם חסומים ללקוח לחלוטין. הדגל נקבע דרך setSilentMode,
    // כלומר עובר דרך פונקציית שרת שבודקת מנהל-על ורושמת ביומן
    // הביקורת. כלל שהיה מתיר לסגל לכתוב ישירות ל-config/runtime
    // היה מאפשר להשתיק את קריאות הפתע של כל התחנה בלי שיישאר
    // רישום מי עשה זאת.

    // מצב המערכת — ניסוי או חי.
    //
    // **נקרא בידי כל חבר תחנה, נכתב בשרת בלבד.** הקריאה נחוצה
    // כדי שפס "מצב ניסוי" יופיע בכל מסך: בלעדיו מפקד ששולח
    // קריאת פתע ולא רואה תגובה מסיק שההזעקה שבורה.
    //
    // המסמך מכיל שני שדות בלבד — mode ו-since. רשימת הפטורים
    // מהשקט יושבת ב-config/runtime, שנשאר חסום לחלוטין.
    match /config/mode {
      allow read: if member('eilat_102') || isSuper();
      allow write: if false;
    }

    match /config/{docId} {
      allow read, write: if false;
    }

    match /silenced/{entryId} {
      allow read, write: if false;
    }

    // קוד ההצטרפות ומוני הניסיונות. חסומים ללקוח לחלוטין —
    // קוד שאפשר לקרוא הוא קוד שאין בו טעם, ומונה ניסיונות
    // שאפשר לכתוב אליו הוא הגבלת קצב שאפשר לאפס.
    match /join_attempts/{uid} {
      allow read, write: if false;
    }


    // ---------- חיפוש עובד ----------
    //
    // כל כבאי בארץ יכול לחפש עובד ולראות: שם, תפקיד, משמרת,
    // תחנה ומחוז.
    //
    // מה שלא נמצא כאן בכוונה: מספר עובד, מייל, טלפון.
    // חיפוש עובד נועד לשיוך מקצועי, לא לפרטים אישיים.
    //
    // נכתב על ידי השרת בלבד.

    match /directory/{uid} {
      allow read:  if approved() || isSuper();
      allow write: if false;
    }


    // ---------- כללי שכר (גלובלי) ----------

    match /salary_rules/{versionId} {
      allow read:  if approved() || isSuper();
      allow write: if isSuper();
    }

    // ---------- יומן שינויי הרשאות ----------
    // נכתב רק על ידי Cloud Functions, שעוקפות את הכללים האלה.
    // לקוח לא יכול לכתוב, ורק מנהל-על יכול לקרוא.

    match /admin_audit/{entryId} {
      allow read:  if isSuper();
      allow write: if false;
    }

    // ---------- התחנה ----------

    match /stations/{sid} {
      // השדה נקרא districtId בכל המערכת; הגרסה הקודמת חיפשה
      // district ולכן נכשלה תמיד. שים לב שמסמך התחנה עצמו אינו
      // נוצר היום — כל עוד כך, מפקד מחוז עדיין ייחסם, כי resource
      // הוא null. זה נשאר פתוח עד שניצור את מסמכי התחנות.
      allow read:  if member(sid) || inDistrict(resource.data.get('districtId', ''));
      allow write: if isSuper();


      // ---------- רשימת הכבאים של התחנה ----------
      // נסגר ללקוחות. ההצלבה בין קוד אישי למשתמש קורית בשרת,
      // בפונקציה approveRegistration. ככה אי אפשר לסרוק את
      // הרשימה כדי לגלות מיילים או קודים של אחרים.

      match /pending_users/{code} {
        allow read:  if hr(sid);
        allow write: if hr(sid);
      }


      // ---------- משתמשים ----------
      // יצירה ומחיקה בשרת בלבד. Cloud Functions עוקפות כללים,
      // ולכן false כאן לא חוסם אותן — רק את הלקוח.

      // מספר העובד משמש גם כאמצעי הגנה מפני זדון, ולכן הוא סוד.
      //
      // בגרסה הקודמת כל חבר תחנה קרא את מסמכי כולם, כולל מספרי
      // העובד — מה שאיפס את ערך ההגנה שלהם. עכשיו כבאי קורא
      // את עצמו בלבד, וסגל קורא את כולם.
      //
      // רשימת אנשי התחנה לתצוגה מגיעה מאוסף roster נפרד.
      match /users/{uid} {
        allow read: if staff(sid)
                    || (signedIn() && request.auth.uid == uid);

        allow create, delete: if false;

        // עדכון עצמי: רק שדות לא רגישים. תפקיד, משמרת, קוד אישי
        // וסטטוס פעיל נקבעים בשרת ולא ניתנים לשינוי מהדפדפן.
        allow update: if signedIn()
                      && request.auth.uid == uid
                      && request.resource.data.role          == resource.data.role
                      && request.resource.data.crew          == resource.data.crew
                      && request.resource.data.employee_number == resource.data.employee_number
                      && request.resource.data.is_active     == resource.data.is_active;

        allow update: if hr(sid);
      }


      // ---------- תחנות קצה ----------
      // תחנה אזורית מכילה כמה תחנות קצה במרחב שלה.
      // באילת: ראשית, שחמון, תמנע, יטבתה.

      match /sub_stations/{subId} {
        allow read:  if member(sid);
        allow write: if staff(sid);
      }


      // ---------- משמרות ----------
      // מסמך לכל משמרת — א, ב, ג — ותחתיו כל מה ששייך לה.

      match /shifts/{crew} {
        allow read:  if member(sid) && seesShift(sid, crew);
        allow write: if staff(sid) && seesShift(sid, crew);

        match /{document=**} {
          allow read:  if member(sid) && seesShift(sid, crew);
          allow write: if staff(sid) && seesShift(sid, crew);
        }
      }


      // ---------- בקרת גישה ----------
      // מי מחובר עכשיו ומתי התחבר לאחרונה.
      //
      // הכבאי מדווח על עצמו בלבד, ורק שדה זמן. הוא לא יכול
      // לכתוב על אחרים ולא לזייף התחברות של מישהו אחר.
      //
      // הסגל רואה את כל התחנה — זה קובץ בקרת הגישה.

      match /presence/{uid} {
        allow read: if staff(sid)
                    || (signedIn() && request.auth.uid == uid);

        // הגרסה הקודמת אפשרה לכל מחובר לכתוב לכל תחנה בארץ, ולציין
        // מספר עובד ושם של מישהו אחר, ותאריך כניסה מומצא — בקובץ
        // שכל מטרתו היא בקרת גישה.
        allow write: if member(sid)
                     && request.auth.uid == uid
                     && request.resource.data.keys().hasOnly(
                          ['last_seen', 'last_login', 'emp', 'full_name', 'crew'])
                     && request.resource.data.get('emp', myEmp()) == myEmp()
                     && request.resource.data.get('last_login', request.time) == request.time;
      }


      // ---------- רשימת אנשי התחנה לתצוגה ----------
      // שם, תפקיד ומשמרת בלבד. בלי מספר עובד, טלפון או מייל.
      // נכתב על ידי השרת בלבד.

      match /roster/{uid} {
        allow read:  if member(sid);
        allow write: if false;
      }


      // ---------- כשירויות ----------
      // מערך הכשירויות שייך לתחנה ולא למערכת: כל תחנה מחזיקה
      // מערך אחר, ותחנה שנפתחת מחר לא יורשת את זה של אילת.
      //
      // כל אנשי התחנה קוראים — כבאי צריך לדעת מי כשיר למה
      // כשהוא במשמרת. רק סגל עורך.

      match /quals/{qid} {
        allow read: if member(sid);

        allow create, update: if staff(sid)
          && request.resource.data.keys().hasOnly(
               ['name', 'order', 'active', 'created_at', 'updated_at', 'by'])
          && request.resource.data.get('name', '') is string
          && request.resource.data.get('name', '').size() > 0
          && request.resource.data.get('name', '').size() <= 40;

        allow delete: if staff(sid);
      }

      // הכשירויות של אדם. אוסף נפרד ולא שדה על roster, כי roster
      // נכתב בשרת בלבד — פתיחתו לכתיבה מהדפדפן הייתה מאפשרת
      // לשנות שם, תפקיד ומשמרת של כל אחד.
      //
      // כבאי לא כותב כאן, גם לא על עצמו: אחרת הוא מעניק לעצמו
      // כשירות ונספר בקו האדום על יכולת שאין לו.

      match /member_quals/{uid} {
        allow read: if member(sid);

        allow create, update: if staff(sid)
          && request.resource.data.keys().hasOnly(['quals', 'updated_at', 'by'])
          && request.resource.data.get('quals', []) is list
          && request.resource.data.get('quals', []).size() <= 60;

        allow delete: if staff(sid);
      }

      // הגדרות התחנה. שני מסמכים, וכל אחד עם צורה משלו:
      //
      //   redline  סף מספרי אחד ומינימום לכל כשירות
      //   board    מבנה הציוות — רכבים, משבצות ושרשרת פיקוד
      //
      // המבנה משותף לשלוש המשמרות. השיבוץ עצמו יושב תחת
      // shifts/{crew}, כי הוא שונה בכל משמרת.
      //
      // שם מסמך שאינו אחד השניים נדחה. בלי הבדיקה הזו, כתיבה
      // אחת עם שם שגוי יוצרת מסמך שאף מסך לא קורא ואף אחד
      // לא יודע שהוא שם.

      match /config/{docId} {
        allow read: if member(sid);

        allow create, update: if staff(sid) && (
          (
            docId == 'redline'
            && request.resource.data.keys().hasOnly(
                 ['min_headcount', 'min_quals', 'updated_at', 'by'])
            && request.resource.data.get('min_headcount', 0) is int
            && request.resource.data.get('min_headcount', 0) >= 0
            && request.resource.data.get('min_headcount', 0) <= 200
          ) || (
            docId == 'hr'
            && request.resource.data.keys().hasOnly(
                 ['email', 'name', 'hour_limit', 'updated_at', 'by'])
            && request.resource.data.get('hour_limit', 0) is int
            && request.resource.data.get('hour_limit', 0) >= 0
            && request.resource.data.get('hour_limit', 0) <= 1000
          ) || (
            // מפתח ה-VAPID להתראות פוש. נוצר בקונסולה של Firebase.
            // הוא ציבורי מטבעו — הדפדפן של כל משתמש מקבל אותו —
            // ולכן קריאה פתוחה לחברי התחנה. כתיבה למנהל-על בלבד.
            docId == 'push'
            && isSuper()
            && request.resource.data.keys().hasOnly(
                 ['vapid_key', 'updated_at', 'by'])
          ) || (
            docId == 'board'
            && request.resource.data.keys().hasOnly(
                 ['vehicles', 'command', 'updated_at', 'by'])
            && request.resource.data.get('vehicles', []) is list
            && request.resource.data.get('vehicles', []).size() <= 40
            && request.resource.data.get('command', []) is list
            && request.resource.data.get('command', []).size() <= 20
          )
        );

        allow delete: if staff(sid);
      }


      // ---------- מוצבים, רכבים, מחזורי סידור ----------

      match /units/{unitId} {
        allow read:  if member(sid);
        allow write: if staff(sid);
      }

      // רכבי עיגון — רכבים קטנים למשימות לוגיסטיות. רכבי כיבוי
      // וחילוץ אינם כאן; הם מוגדרים בתוך config/board, כי שם הם
      // נושאים משבצות ותפקידים. כל רכב חי במקום אחד בדיוק.
      match /vehicles/{vehicleId} {
        allow read:  if member(sid);
        allow write: if staff(sid);
      }

      // תצלומים ליליים — ספירת מסמכים לגילוי אובדן נתונים.
      // נכתבים בשרת בלבד. מנהל-על קורא כדי לראות מגמה.
      match /backups/{dateId} {
        allow read:  if isSuper();
        allow write: if false;
      }

      // ---------- ארבע תמונות הרכב ----------
      //
      // הרקע שעליו נתלים דיווחי התקלות והפגיעות: חזית, ימין,
      // אחור, שמאל. מזהה המסמך הוא vehicleId__side, ולכן העלאה
      // חוזרת מחליפה ואי אפשר להגיע לשתי תמונות חזית.
      //
      // **יצירה לכל חבר תחנה, החלפה לסגל בלבד.** אלדד ביקש
      // שהכבאי יצלם ויעלה, וזה מה שהיצירה מאפשרת. אבל החלפת
      // תמונה קיימת בזווית אחרת מזיזה את כל הנקודות שכבר
      // סומנו עליה — הן נשמרות כיחס לתמונה, לא לרכב. תוצאה:
      // עשרה דיווחים מדויקים הופכים בבת אחת למטעים, בלי שאיש
      // ישים לב. לכן זו פעולה של סגל.
      match /vehicle_views/{viewId} {
        allow read: if member(sid);

        allow create: if member(sid)
                      && request.resource.data.get('vehicle_id', '') != ''
                      && request.resource.data.get('side', '') in
                         ['front', 'right', 'rear', 'left']
                      && request.resource.data.get('by_uid', '') == request.auth.uid
                      && request.resource.data.get('photo', '') is string
                      && request.resource.data.get('photo', '').size() > 0
                      && request.resource.data.get('photo', '').size() <= 900000;

        allow update: if staff(sid)
                      && request.resource.data.get('vehicle_id', '') ==
                         resource.data.get('vehicle_id', '')
                      && request.resource.data.get('side', '') ==
                         resource.data.get('side', '')
                      && request.resource.data.get('photo', '').size() <= 900000;

        allow delete: if staff(sid);
      }

      // ---------- טפסים ----------
      //
      // בקשת חופשה, דוח אי החתמת כרטיס, דוח פציעה, דוח נזק.
      // ראש המשמרת או סגנו מאשרים.
      //
      // דוח פציעה הוא מידע רפואי על אדם, ולכן is_private חוסם
      // אותו מכל מי שאינו: המגיש עצמו, סגל המשמרת שלו, מפקד
      // התחנה, ורכז כוח אדם. כבאי אחר לא רואה אותו, ומפקד של
      // משמרת אחרת לא רואה אותו.
      //
      // מה שנעול אחרי ההגשה: המגיש, השדות והחתימה. אין טעם
      // בחתימה שאפשר לצרף אחריה טקסט אחר.

      match /submissions/{subId} {
        allow read: if resource.data.get('by_uid', '') == request.auth.uid
                    || (resource.data.get('is_private', false) == false
                        && staff(sid)
                        && seesCrewData(sid, resource.data.get('crew', '')))
                    || (resource.data.get('is_private', false) == true
                        && (hr(sid) || stationCommander(sid)
                            || (staff(sid)
                                && myShift() != ''
                                && myShift() == resource.data.get('crew', ''))));

        allow create: if member(sid)
                      && request.resource.data.get('by_uid', '') == request.auth.uid
                      && request.resource.data.get('status', '') == 'submitted'
                      && request.resource.data.get('form_id', '') != ''
                      && request.resource.data.get('signature', '').size() <= 400000;

        // הכרעה: הסגל של אותה משמרת, או ביטול בידי המגיש.
        allow update: if ((staff(sid)
                           && seesCrewData(sid, resource.data.get('crew', ''))
                           && request.resource.data.get('status', '') in
                              ['approved', 'rejected'])
                          || (resource.data.get('by_uid', '') == request.auth.uid
                              && request.resource.data.get('status', '') == 'cancelled'))
                      && resource.data.get('status', '') == 'submitted'
                      && request.resource.data.get('by_uid', '') == resource.data.get('by_uid', '')
                      && request.resource.data.get('values', {}) == resource.data.get('values', {})
                      && request.resource.data.get('signature', '') == resource.data.get('signature', '');

        allow delete: if isSuper();
      }


      // ---------- היתר לרדת מתחת לקו האדום ----------
      //
      // ראש המשמרת או סגנו מבקשים; מפקד התחנה מאשר. שני שלבים
      // ולא אחד, כי זו החלטה שמוציאה משמרת לשטח בתקן חסר.
      //
      // המבקש אינו יכול לאשר לעצמו — הכלל השני דורש
      // stationCommander, ו-staff() אינו מספיק.
      //
      // אין נימוק בכוונה. אלדד: "לא צריך נימוק, מפקד המשמרת
      // קיבל את ההחלטה היא שלו." מה שכן נשמר: מי ביקש, מי
      // אישר, ומתי.

      match /redline_waivers/{wId} {
        allow read: if member(sid);

        allow create: if staff(sid)
                      && request.resource.data.get('by_uid', '') == request.auth.uid
                      && request.resource.data.get('status', '') == 'pending'
                      && request.resource.data.get('crew', '') != ''
                      && request.resource.data.get('date', '') != '';

        // רק מפקד התחנה מכריע, ורק על בקשה שממתינה.
        allow update: if stationCommander(sid)
                      && resource.data.get('status', '') == 'pending'
                      && request.resource.data.get('status', '') in ['approved', 'rejected']
                      && request.resource.data.get('by_uid', '') == resource.data.get('by_uid', '')
                      && request.resource.data.get('crew', '') == resource.data.get('crew', '')
                      && request.resource.data.get('date', '') == resource.data.get('date', '');

        allow delete: if isSuper();
      }


      // ---------- מסירת אחריות ----------
      //
      // זו חתימה, לא רשומה רגילה. אלדד הגדיר: מפקד משמרת או
      // סגנו מאשר קבלת אחריות, ונרשם בלוג מי מסר למי ומתי.
      //
      // ולכן הכלל היחיד שחשוב כאן: **אין update ואין delete.**
      // רשומה שאפשר לערוך בדיעבד אינה חתימה אלא הערה. מפקד
      // שחתם על משמרת שהתבררה כבעייתית לא יוכל לשנות את
      // השעה או להעביר את השם.
      //
      // תיקון של רישום שגוי נעשה ברישום חדש, לא במחיקה — כך
      // גם הטעות וגם התיקון נשארים גלויים.
      //
      // מי שחותם: הסגל בלבד. השם נעול למי שכתב.

      match /handovers/{hoId} {
        allow read: if member(sid);

        allow create: if staff(sid)
                      && request.resource.data.get('to_uid', '') == request.auth.uid
                      && request.resource.data.get('crew', '') != ''
                      && request.resource.data.get('date', '') != ''
                      && request.resource.data.get('accepted_key', '') != ''
                      && request.resource.data.get('assessment', '').size() <= 600;

        allow update, delete: if false;
      }

      // ---------- תקלות וחפיפת משמרת ----------
      //
      // כל כבאי מדווח תקלה, וזו הנקודה: מי שרואה את הנזילה הוא
      // מי שעומד ליד הרכב, לא מי שיושב במשרד. לכן create פתוח
      // לכל חבר תחנה, ושם המדווח ננעל למי שכתב.
      //
      // סגירה: הסגל סוגר הכל; מי שפתח סוגר את שלו. כבאי שדיווח
      // בטעות לא צריך לחפש מפקד כדי לבטל.
      //
      // מה שאי אפשר לשנות אחרי הפתיחה: מי דיווח ומתי. זו כל
      // הנקודה של חפיפת משמרת — רישום שלא זז.

      match /faults/{faultId} {
        allow read: if member(sid);

        allow create: if member(sid)
                      && request.resource.data.get('by_uid', '') == request.auth.uid
                      && request.resource.data.get('title', '') is string
                      && request.resource.data.get('title', '').size() > 0
                      && request.resource.data.get('title', '').size() <= 80
                      && request.resource.data.get('desc', '').size() <= 600
                      && request.resource.data.get('status', '') == 'open';

        allow update: if (staff(sid) || resource.data.get('by_uid', '') == request.auth.uid)
                      && request.resource.data.get('by_uid', '') == resource.data.get('by_uid', '')
                      && request.resource.data.get('by_name', '') == resource.data.get('by_name', '')
                      && request.resource.data.get('created_key', '') == resource.data.get('created_key', '')
                      && request.resource.data.get('title', '') == resource.data.get('title', '');

        // מחיקה. רק פגיעות רכב, ורק בידי הסגל.
        //
        // תקלה רגילה נסגרת ונשארת בהיסטוריה. פגיעה שתוקנה
        // בפועל במוסך כבר לא קיימת על הרכב, ולכן היא נמחקת —
        // אלדד הגדיר זאת במפורש, והמחיקה סופית.
        //
        // תקלה שאינה פגיעה לא נמחקת בשום מקרה מלבד מנהל-על:
        // מי שדיווח בטעות סוגר, לא מוחק.
        allow delete: if isSuper()
                      || (staff(sid) && resource.data.get('kind', '') == 'damage');

        // צילומים. נשמרים כמסמך נפרד תחת התקלה כדי שמסמך התקלה
        // יישאר קטן ושהתמונה תיטען רק כשמסתכלים בה.
        match /photos/{photoId} {
          allow read: if member(sid);
          allow create: if member(sid)
                        && request.resource.data.get('by_uid', '') == request.auth.uid;
          allow update: if false;
          allow delete: if staff(sid);
        }
      }

      match /rotations/{rotationId} {
        allow read:  if member(sid);
        allow write: if staff(sid);
      }

      match /shift_overrides/{overrideId} {
        allow read:  if member(sid);
        allow write: if staff(sid);
      }

      match /postings/{postingId} {
        allow read:  if member(sid);
        allow write: if staff(sid);
      }


      // ---------- נוכחות ----------
      // הכבאי כותב רק את עצמו, ורק כל עוד הרישום לא אושר.
      //
      // שני השדות emp_number ו-status נעולים בעדכון: בלי זה
      // כבאי יכול לאשר לעצמו שעות ולעקוף את הקצין, או לשייך
      // רישום שלו למספר עובד של כבאי אחר.

      // מזהה הרשומה: {מספר עובד}_{YYYY-MM-DD}. יום אחד לאדם,
      // כמו במערכת שרצה היום.
      //
      // הנעילה אחרי אישור עובדת דרך השדה status על כל רשומה
      // ולא דרך קריאת מסמך הדוח החודשי: לקובץ הזה אין אף
      // קריאת get(), במכוון, ולא נשבור את זה בשביל נעילה אחת.
      // המאשר כותב 'approved' על כל רשומות החודש בפעולה אחת.

      match /attendance/{docId} {
        allow read: if (staff(sid) && seesCrewData(sid, resource.data.get('crew', '')))
                    || (member(sid) && resource.data.get('emp_number', '') == myEmp());

        allow create: if (staff(sid)
                          && seesCrewData(sid, request.resource.data.get('crew', '')))
                      || (member(sid)
                          && request.resource.data.get('emp_number', '') == myEmp()
                          && request.resource.data.keys().hasAll(['status'])
                          && request.resource.data.get('status', '') != 'approved');

        allow update: if (staff(sid)
                          && seesCrewData(sid, resource.data.get('crew', '')))
                      || (member(sid)
                          && resource.data.get('emp_number', '') == myEmp()
                          && request.resource.data.get('emp_number', '') == resource.data.get('emp_number', '')
                          && resource.data.get('status', '') != 'approved'
                          && request.resource.data.get('status', '') != 'approved');

        allow delete: if (staff(sid)
                          && seesCrewData(sid, resource.data.get('crew', '')))
                      || (member(sid)
                          && resource.data.get('emp_number', '') == myEmp()
                          && resource.data.get('status', '') != 'approved');
      }


      // ---------- מזהי מכשיר להתראות ----------
      //
      // כל אחד כותב וקורא את שלו בלבד. אין למי מהסגל סיבה
      // לקרוא מזהי מכשיר של אחרים: השליחה קורית בשרת, שעוקף
      // את הכללים האלה ממילא.
      //
      // מזהה מכשיר הוא מפתח לשליחת התראה למכשיר מסוים. דליפה
      // שלו מאפשרת לשלוח הודעות לטלפון של כבאי בשם המערכת.

      match /push_tokens/{uid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // הודעות שנשלחו ביד. נשמרות כדי שיהיה תיעוד מי שלח מה
      // ולמי — הודעה לכל המשמרת היא פעולה ניהולית, לא צ׳אט.
      //
      // מי רשאי לשלוח, לפי אלדד:
      //   מפקד משמרת   למשמרת שלו
      //   רכז כוח אדם  לכל התחנה
      //   מנהל-על      לכל התחנה
      //   כבאי         לכבאים במשמרת שלו
      //
      // האכיפה האמיתית היא בפונקציית השליחה בשרת. הכלל כאן
      // מונע כתיבת תיעוד מזויף.

      match /broadcasts/{msgId} {
        allow read: if member(sid);
        allow create: if member(sid)
                      && request.resource.data.get('by_uid', '') == request.auth.uid
                      && request.resource.data.get('text', '') is string
                      && request.resource.data.get('text', '').size() > 0
                      && request.resource.data.get('text', '').size() <= 400;
        allow update, delete: if isSuper();
      }

      // ---------- אבטחות ----------
      //
      // אבטחה היא הצבת כוח באירוע. שלוש פעולות, שלוש רמות:
      //
      //   קריאה   כל חבר תחנה. אבטחה אינה סוד, וכל אחד צריך
      //           לראות מה פתוח כדי להירשם
      //   פתיחה   סגל בלבד — מפקד, רכז כוח אדם, מנהל-על
      //   שיבוץ   דרך פונקציית שרת בלבד
      //
      // הרשמה עצמית עוברת גם היא דרך השרת (guardSignup), ולכן
      // הכלל כאן חוסם כתיבה ישירה של signups מהדפדפן. הסיבה:
      // הרשמה משנה מסמך משותף, ומשתמש שיכול לכתוב לתוכו יכול
      // גם למחוק את ההרשמות של האחרים.
      //
      // אבטחה שאין עליה שיבוץ פתוחה לעריכה בידי הסגל. משיש
      // שיבוץ — רק השרת נוגע, אחרת מפקד יכול לשנות תאריך מתחת
      // לרגליים של מי שכבר תכנן את היום שלו.

      match /guards/{gId} {
        allow read: if member(sid);

        allow create: if staff(sid)
                      && request.resource.data.get('by_uid', '') == request.auth.uid
                      && request.resource.data.get('title', '') is string
                      && request.resource.data.get('title', '').size() > 0
                      && request.resource.data.get('title', '').size() <= 80
                      && request.resource.data.get('date', '') is string
                      && request.resource.data.get('date', '').size() == 10
                      && request.resource.data.get('slots', 0) is int
                      && request.resource.data.get('slots', 0) > 0
                      && request.resource.data.get('slots', 0) <= 20
                      && request.resource.data.get('assigned', []).size() == 0;

        // עריכה מהדפדפן רק כשאין עדיין משובצים, ורק לשדות
        // התיאור. signups ו-assigned נכתבים בשרת בלבד.
        allow update: if staff(sid)
                      && resource.data.get('assigned', []).size() == 0
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly([
                             'title','kind','place','date','start','end',
                             'slots','need_quals','notes','status'
                           ]);

        allow delete: if staff(sid)
                      && resource.data.get('assigned', []).size() == 0;
      }


      // ---------- קריאת פתע ----------
      //
      // הזעקה. נוצרת אך ורק בפונקציית sendCallout בשרת — הכלל
      // כאן חוסם יצירה מהדפדפן לגמרי, כי קריאת פתע עוקפת את
      // העדפות ההתראות של כל מי שברשימה, ולכן היא הדבר האחרון
      // שמותר לזייף.
      //
      // מה שכן מותר מהדפדפן: לענות. כל אדם כותב מפתח אחד בלבד
      // בתוך acks, את המפתח ששמו עליו, ולא נוגע בשום שדה אחר.
      // כך אי אפשר לענות בשם חבר, ואי אפשר לשנות את נוסח
      // הקריאה אחרי שיצאה.
      //
      // שלוש בדיקות, וכל אחת סוגרת פרצה אחרת:
      //
      //   uids       רק מי שהקריאה נשלחה אליו יכול לענות. בלי
      //              זה כל חבר תחנה יכול היה לנפח את ספירת
      //              "מגיעים" בקריאה שאינה שלו, והמפקד היה
      //              סופר אנשים שלא הוזעקו
      //   acks       מפתח אחד, שלו
      //   resp       ערך מוכר בלבד. diff מזהה שינוי בתוכן, אבל
      //              אינו מאמת אותו — בלי הבדיקה הזו אפשר
      //              לכתוב כל דבר תחת המפתח שלך

      match /callouts/{coId} {
        allow read: if member(sid);
        allow create, delete: if false;

        allow update: if member(sid)
                      && request.auth.uid in resource.data.get('uids', [])
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['acks'])
                      && request.resource.data.get('acks', {})
                           .diff(resource.data.get('acks', {}))
                           .affectedKeys().hasOnly([request.auth.uid])
                      && request.resource.data.get('acks', {})
                           .get(request.auth.uid, {})
                           .get('resp', '') in ['coming', 'no'];
      }


      // ---------- החלפות משמרת ----------
      // שמות שני הצדדים נעולים, והמקבל לא יכול לאשר סופית.
      //
      // הערה פתוחה: שם הסטטוס הסופי ('approved') הוא הנחה.
      // צריך לאמת מול הקוד כשמודול ההחלפות ייכתב.

      // ---------- החלפות משמרת ----------
      //
      // המסלול, לפי אלדד:
      //
      //   peer      נשלחה. הכבאי השני צריך להסכים
      //   cmd_from  הצד השני הסכים. מפקד המשמרת של המבקש בוחן
      //   cmd_to    מפקד המבקש אישר. מפקד המשמרת השנייה בוחן
      //   approved  שני המפקדים אישרו
      //   rejected  נדחתה, עם נימוק ועם שם הדוחה
      //   cancelled המבקש ביטל
      //
      // הסכמת הכבאי השני היא שלב ראשון ולא קישוט: בלעדיה
      // אפשר להתנדב בשמו של מישהו אחר, והמפקד מקבל בקשה
      // שהצד השני לא יודע עליה.
      //
      // כל אחד מהשניים יכול לבטל כל עוד לא אושרה סופית.
      // מפקד מאשר רק את המשמרת שלו — seesShift אוכף את זה.

      match /swaps/{swapId} {
        allow read: if member(sid);

        // שני מסלולים ליצירה:
        //
        //   peer  בקשה מכוונת לאדם מסוים
        //   open  בקשה פתוחה — "מי מוכן להחליף איתי" — שכל
        //         אחד יכול לקחת
        //
        // הזיהוי הוא לפי uid ולא לפי מספר עובד. הגרסה הקודמת
        // בדקה from_emp/to_emp בכללים בזמן שהיצירה שמרה שם
        // מחרוזת ריקה, ולכן שום הסכמה לא הייתה עוברת בשרת.
        // מספר עובד גם אינו נחוץ כאן — אלדד ביקש חיפוש בשם.
        allow create: if member(sid)
                      && request.resource.data.get('from_uid', '') == request.auth.uid
                      && request.resource.data.get('status', '') in ['peer', 'open']
                      && request.resource.data.get('from_crew', '') != ''
                      && request.resource.data.get('from_date', '') != ''
                      && (request.resource.data.get('status', '') == 'open'
                          || (request.resource.data.get('to_uid', '') != ''
                              && request.resource.data.get('to_uid', '') != request.auth.uid
                              && request.resource.data.get('to_crew', '') != ''));

        // לקיחת בקשה פתוחה. מי שלוקח קובע את עצמו כצד השני
        // ומציע את היום שלו בתמורה — ובכך גם נותן את הסכמתו,
        // ולכן הבקשה עוברת ישר למפקדים.
        //
        // הצד של המבקש נעול לגמרי: מי שלוקח לא משנה את התאריך
        // או את המשמרת של מי שפרסם.
        allow update: if member(sid)
                      && resource.data.get('status', '') == 'open'
                      && request.resource.data.get('status', '') == 'cmd_from'
                      && request.resource.data.get('to_uid', '') == request.auth.uid
                      && resource.data.get('from_uid', '') != request.auth.uid
                      && request.resource.data.get('to_date', '') != ''
                      && request.resource.data.get('to_crew', '') != ''
                      && request.resource.data.get('from_uid', '')  == resource.data.get('from_uid', '')
                      && request.resource.data.get('from_date', '') == resource.data.get('from_date', '')
                      && request.resource.data.get('from_crew', '') == resource.data.get('from_crew', '');

        // הכבאי השני מסכים או מסרב. הוא לא יכול לאשר סופית.
        allow update: if member(sid)
                      && resource.data.get('to_uid', '') == request.auth.uid
                      && resource.data.get('status', '') == 'peer'
                      && request.resource.data.get('status', '') in ['cmd_from', 'rejected']
                      && request.resource.data.get('from_uid', '') == resource.data.get('from_uid', '')
                      && request.resource.data.get('to_uid', '')   == resource.data.get('to_uid', '')
                      && request.resource.data.get('from_crew', '') == resource.data.get('from_crew', '')
                      && request.resource.data.get('to_crew', '')   == resource.data.get('to_crew', '');

        // מפקד המשמרת של המבקש.
        allow update: if staff(sid)
                      && seesShift(sid, resource.data.get('from_crew', ''))
                      && resource.data.get('status', '') == 'cmd_from'
                      && request.resource.data.get('status', '') in ['cmd_to', 'rejected']
                      && request.resource.data.get('from_uid', '') == resource.data.get('from_uid', '')
                      && request.resource.data.get('to_uid', '')   == resource.data.get('to_uid', '')
                      && request.resource.data.get('from_crew', '') == resource.data.get('from_crew', '')
                      && request.resource.data.get('to_crew', '')   == resource.data.get('to_crew', '');

        // מפקד המשמרת השנייה. רק הוא יכול להביא ל-approved.
        //
        // ואינו אותו אדם שאישר את השלב הקודם. רכז כוח אדם
        // ומנהל-על עוברים את seesShift לכל המשמרות, ולכן בלי
        // התנאי הזה אדם אחד יכול היה להעביר בקשה משני שלבי
        // המפקדים לבדו — בזמן שכל התכנון הוא ששניים אישרו.
        allow update: if staff(sid)
                      && seesShift(sid, resource.data.get('to_crew', ''))
                      && request.auth.uid != resource.data.get('from_appr_uid', '')
                      && resource.data.get('status', '') == 'cmd_to'
                      && request.resource.data.get('status', '') in ['approved', 'rejected']
                      && request.resource.data.get('from_uid', '') == resource.data.get('from_uid', '')
                      && request.resource.data.get('to_uid', '')   == resource.data.get('to_uid', '')
                      && request.resource.data.get('from_crew', '') == resource.data.get('from_crew', '')
                      && request.resource.data.get('to_crew', '')   == resource.data.get('to_crew', '');

        // ביטול על ידי אחד השניים, כל עוד לא אושרה.
        allow update: if member(sid)
                      && (resource.data.get('from_uid', '') == request.auth.uid
                          || resource.data.get('to_uid', '') == request.auth.uid)
                      && resource.data.get('status', '') != 'approved'
                      && request.resource.data.get('status', '') == 'cancelled'
                      && request.resource.data.get('from_uid', '') == resource.data.get('from_uid', '')
                      && request.resource.data.get('to_uid', '')   == resource.data.get('to_uid', '')
                      && request.resource.data.get('from_crew', '') == resource.data.get('from_crew', '')
                      && request.resource.data.get('to_crew', '')   == resource.data.get('to_crew', '');

        allow delete: if isSuper();
      }


      // ---------- מסמכים ----------

      match /documents/{docId} {
        allow read: if hr(sid)
                    || (member(sid) && resource.data.get('emp_number', '') == myEmp());
        allow create: if member(sid)
                      && request.resource.data.get('emp_number', '') == myEmp();
        allow update, delete: if hr(sid);
      }


      // ---------- אירועי אבטחה ----------

      match /security_events/{eventId} {
        allow read:  if member(sid);
        allow write: if staff(sid);
      }


      // ---------- דוחות חודשיים ----------

      // דוח חודשי לאדם. מזהה: {מספר עובד}_{YYYY-MM}.
      //
      //   draft      נפתח מעצמו ברגע שהכבאי מדווח יום ראשון
      //   submitted  הכבאי שלח לאישור
      //   approved   המפקד או רכז כוח אדם אישרו
      //
      // הכבאי יכול לשלוח ולחזור בו, ולא יכול לאשר לעצמו.
      // מפקד משמרת מאשר את האנשים שלו; רכז כוח אדם ומנהל-על
      // מאשרים את כל התחנה — כדי שסוף חודש לא ייתקע כשמפקד
      // בחופשה.

      // תוצאות הריצה הלילית ודוחות משאבי אנוש. נכתבים בשרת
      // בלבד; הסגל קורא כדי לראות מה נמצא.
      // סריקה לילית ודוח משאבי אנוש. שני המסמכים כלל-תחנתיים
      // ומכילים את השעות של כל אדם בתחנה — ולכן מפקד משמרת
      // שקורא אותם רואה את שתי המשמרות האחרות, בניגוד לכלל.
      // אי אפשר לצמצם אותם לפי משמרת כי הם מסמך אחד לחודש,
      // ולכן הגישה מצטמצמת לרכז כוח אדם ולמנהל-על.
      //
      // מפקד לא מאבד דבר: הממצאים שנוגעים לאנשיו מגיעים אליו
      // בהתראה ובדוח החודשי, ושניהם ממילא מצומצמים למשמרת שלו.

      match /scans/{monthKey} {
        allow read:  if hr(sid) || stationCommander(sid);
        allow write: if false;
      }

      match /hr_reports/{monthKey} {
        allow read:  if hr(sid) || stationCommander(sid);
        allow write: if false;
      }

      match /monthly_reports/{docId} {
        allow read: if (staff(sid) && seesCrewData(sid, resource.data.get('crew', '')))
                    || (member(sid) && resource.data.get('emp_number', '') == myEmp());

        allow create: if (staff(sid)
                          && seesCrewData(sid, request.resource.data.get('crew', '')))
                      || (member(sid)
                          && request.resource.data.get('emp_number', '') == myEmp()
                          && request.resource.data.get('status', '') != 'approved');

        allow update: if (staff(sid)
                          && seesCrewData(sid, resource.data.get('crew', '')))
                      || (member(sid)
                          && resource.data.get('emp_number', '') == myEmp()
                          && request.resource.data.get('emp_number', '') == resource.data.get('emp_number', '')
                          && resource.data.get('status', '') != 'approved'
                          && request.resource.data.get('status', '') != 'approved');

        allow delete: if staff(sid);
      }
    }


    // ---------- ברירת מחדל: הכל חסום ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
