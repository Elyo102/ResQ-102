// Isolated budget-only fragment: test wrapper required. Never deploy standalone.
  function budgetIdentity() {
   return request.auth != null && request.auth.uid == 'resq-ci-budget-20260928'
    && request.auth.token.control_plane_budget == true
    && !('control_plane_agent' in request.auth.token)
    && request.auth.token.control_plane_authorization is string
    && request.auth.token.control_plane_authorization.matches('^[A-Za-z0-9-]{8,64}$');
  }
  function aid() { return request.auth.token.control_plane_authorization; }
  function grantPath(id) { return /databases/$(database)/documents/resq_budget_authorizations/$(id); }
  function monthPath(id) { return /databases/$(database)/documents/resq_budget_state/$(id); }
  function policy() { return get(/databases/$(database)/documents/resq_budget_state/policy).data; }
  function tasks() { return {'Claude':'planner_draft_recovery','Grok':'swap_race_review','Gemini':'clean_checkout_gates'}; }
  function monthValid(m,id) {
   return m.keys().hasAll(['year','month','chargedMicroUsd','lastOperationId','lastAuthorizationId'])
    && m.keys().hasOnly(['year','month','chargedMicroUsd','lastOperationId','lastAuthorizationId'])
    && m.year == request.time.year() && m.month == request.time.month()
    && id == 'month_'+string(m.year)+'-'+(m.month < 10 ? '0' : '')+string(m.month)
    && m.chargedMicroUsd is int && m.chargedMicroUsd >= 0 && m.chargedMicroUsd <= 20000000
    && m.chargedMicroUsd % 250000 == 0 && m.lastOperationId is string && m.lastAuthorizationId is string;
  }
  function grantValid(g,id) {
   return g.keys().hasAll(['authorizationId','principal','approvedSha','enabled','expiresAt','monthId','allowedTasks','capMicroUsd','maxReservations','chargedMicroUsd','reservationCount','reservedProviders','lastOperationId','operations'])
    && g.keys().hasOnly(['authorizationId','principal','approvedSha','enabled','expiresAt','monthId','allowedTasks','capMicroUsd','maxReservations','chargedMicroUsd','reservationCount','reservedProviders','lastOperationId','operations'])
    && g.authorizationId == id && g.principal == request.auth.uid
    && g.approvedSha is string && g.approvedSha.matches('^[a-f0-9]{40}$')
    && g.enabled == true && g.expiresAt is timestamp && g.expiresAt > request.time
    && g.monthId is string && g.allowedTasks == tasks() && g.capMicroUsd == 750000 && g.maxReservations == 3
    && g.reservationCount is int && g.reservationCount >= 0 && g.reservationCount <= 3
    && g.chargedMicroUsd == g.reservationCount * 250000
    && g.operations is map && g.operations.keys().hasOnly(['Claude','Grok','Gemini'])
    && g.operations.size() == g.reservationCount && g.reservedProviders is list
    && g.reservedProviders.size() == g.reservationCount
    && g.reservedProviders.toSet() == g.operations.keys().toSet()
    && g.lastOperationId is string;
  }
  function priceValid(q,op) {
   return q.keys().hasAll(['inputMicroUsdPerMillionTokens','outputMicroUsdPerMillionTokens','overheadTokens','fixedMicroUsd','expiresAt'])
    && q.keys().hasOnly(['inputMicroUsdPerMillionTokens','outputMicroUsdPerMillionTokens','overheadTokens','fixedMicroUsd','expiresAt'])
    && q.inputMicroUsdPerMillionTokens is int && q.inputMicroUsdPerMillionTokens >= 0 && q.inputMicroUsdPerMillionTokens <= 1000000000
    && q.outputMicroUsdPerMillionTokens is int && q.outputMicroUsdPerMillionTokens >= 0 && q.outputMicroUsdPerMillionTokens <= 1000000000
    && q.overheadTokens == 1024 && q.fixedMicroUsd is int && q.fixedMicroUsd >= 0 && q.fixedMicroUsd <= 250000
    && q.expiresAt is timestamp && q.expiresAt > request.time && op.expiresAt <= q.expiresAt
    && ((op.inputBytes + 1024) * q.inputMicroUsdPerMillionTokens + op.maxOutputTokens * q.outputMicroUsdPerMillionTokens) <= (250000-q.fixedMicroUsd)*1000000;
  }
  function operationValid(op,p,g) {
   let pol=policy();
   return op.keys().hasAll(['id','provider','model','policyVersion','requestDigest','task','chargedMicroUsd','inputBytes','maxOutputTokens','createdAt','expiresAt'])
    && op.keys().hasOnly(['id','provider','model','policyVersion','requestDigest','task','chargedMicroUsd','inputBytes','maxOutputTokens','createdAt','expiresAt'])
    && pol.keys().hasAll(['enabled','version','chargeMicroUsd','maxBytes','maxOutputTokens','models','pricing'])
    && pol.keys().hasOnly(['enabled','version','chargeMicroUsd','maxBytes','maxOutputTokens','models','pricing'])
    && pol.enabled == true && pol.chargeMicroUsd == 250000 && pol.maxBytes == 60000 && pol.maxOutputTokens == 2200
    && pol.models.keys().hasOnly(['Claude','Grok','Gemini']) && pol.pricing.keys().hasOnly(['Claude','Grok','Gemini'])
    && op.id == g.authorizationId+'_'+p && op.provider == p && op.task == tasks()[p]
    && op.model == pol.models[p] && op.policyVersion == pol.version
    && op.requestDigest is string && op.requestDigest.matches('^[a-f0-9]{64}$')
    && op.chargedMicroUsd == 250000 && op.inputBytes is int && op.inputBytes >= 1 && op.inputBytes <= 60000
    && op.maxOutputTokens is int && op.maxOutputTokens >= 1 && op.maxOutputTokens <= 2200
    && op.createdAt == request.time && op.expiresAt is timestamp && op.expiresAt > request.time
    && op.expiresAt <= request.time + duration.value(20,'s') && op.expiresAt <= g.expiresAt
    && op.expiresAt.year() == request.time.year() && op.expiresAt.month() == request.time.month()
    && priceValid(pol.pricing[p],op);
  }
  function transition(old,g,mb,m) {
   let p=g.reservedProviders[old.reservationCount];
   return grantValid(g,aid())
    && old.reservationCount is int && old.reservationCount >= 0
    && old.chargedMicroUsd is int && old.chargedMicroUsd >= 0
    && g.diff(old).affectedKeys().hasOnly(['chargedMicroUsd','reservationCount','reservedProviders','lastOperationId','operations'])
    && g.reservationCount == old.reservationCount+1 && g.chargedMicroUsd == old.chargedMicroUsd+250000
    && g.reservedProviders == old.reservedProviders.concat([p]) && !(p in old.operations)
    && g.operations.diff(old.operations).affectedKeys().hasOnly([p])
    && operationValid(g.operations[p],p,g) && g.lastOperationId == g.operations[p].id
    && monthValid(m,g.monthId) && mb.chargedMicroUsd is int && mb.chargedMicroUsd >= 0
    && m.diff(mb).affectedKeys().hasOnly(['chargedMicroUsd','lastOperationId','lastAuthorizationId'])
    && m.chargedMicroUsd == mb.chargedMicroUsd+250000
    && m.lastOperationId == g.lastOperationId && m.lastAuthorizationId == aid();
  }
  // The paired grant write runs the full transition once. A changed count proves
  // that grant is written in this same atomic commit, not merely read afterward.
  function linkedMonth(old,m,id) {
   let before=get(grantPath(aid())).data;
   let after=getAfter(grantPath(aid())).data;
   return after.reservationCount == before.reservationCount+1
    && id == after.monthId
    && m.diff(old).affectedKeys().hasOnly(['chargedMicroUsd','lastOperationId','lastAuthorizationId'])
    && old.chargedMicroUsd is int && old.chargedMicroUsd >= 0
    && m.chargedMicroUsd == old.chargedMicroUsd+250000 && m.chargedMicroUsd <= 20000000
    && m.lastAuthorizationId == aid() && m.lastOperationId == after.lastOperationId;
  }
  match /resq_budget_authorizations/{id} {
   allow get: if budgetIdentity() && aid() == id;
   allow update: if budgetIdentity() && aid() == id
    && transition(resource.data,request.resource.data,get(monthPath(resource.data.monthId)).data,getAfter(monthPath(resource.data.monthId)).data);
  }
  match /resq_budget_state/{id} {
   allow get: if budgetIdentity() && (id == 'policy' || id == get(grantPath(aid())).data.monthId);
   allow update: if budgetIdentity() && id == get(grantPath(aid())).data.monthId
    && linkedMonth(resource.data,request.resource.data,id);
  }
