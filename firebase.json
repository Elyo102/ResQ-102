{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix tests run static"
      ],
      "ignore": [
        "node_modules",
        ".git",
        ".gitignore",
        ".env",
        ".env.*",
        ".runtimeconfig.json",
        "*adminsdk*.json",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "*.test.js",
        "**/*.test.js",
        "count-station-claims.js",
        "run-station-claims-audit.js",
        "**/fixtures/**"
      ]
    }
  ],
  "hosting": {
    "public": ".",

    "_הערה_ignore": "שלוש השורות .git/** .github/** .firebase/** אינן מיותרות. '**/.*' לבדו אינו גוזם תיקיות מוסתרות — הוא תפס את התיקייה .git עצמה אבל לא את 362 הקבצים שבתוכה, והפריסה הראשונה ב-25.8.2026 העלתה את כל היסטוריית הריפו לכתובת ציבורית. תיקיית .git על שרת אינטרנט היא יעד סריקה מוכר: מבקשים /.git/HEAD ומשם משחזרים את כל הריפו.",

    "ignore": [
      "firebase.json",
      ".git/**",
      ".github/**",
      ".firebase/**",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "tests/**",
      "rules-test/**",
      "_דיונים/**",
      "roster-import.js",
      "firestore.rules",
      "firestore.indexes.json",
      "firestore_1.rules",
      "**/*.log",
      "firestore-debug.log",
      "ui-debug.log",
      "*.bat",
      "*.mjs",
      "*.md"
    ],

    "_הערה_headers": "הסדר כאן אינו סגנון. Firebase Hosting מחיל את הכלל התואם האחרון, ולכן כלל ספציפי שיושב לפני כלל כללי יותר מפסיד לו. '**/*.@(html|js|css)' תופס גם את firebase-messaging-sw.js, ולכן העובד חייב לשבת אחריו — אחרת Production מחזיר no-cache במקום no-store, וזה בדיוק מה שנמדד. tests/headercheck.mjs מחשב את הכלל האחרון התואם בפועל ונופל אם מישהו יחזיר את הסדר.",

    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/version.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  },

  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
