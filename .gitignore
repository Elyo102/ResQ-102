Thumbs.db
desktop.ini
~$*
*.tmp

# --- editors ---
.vscode/
.idea/
*.swp

# --- בדיקת כללי האבטחה ---
rules-test/node_modules/
firestore-debug.log
ui-debug.log
tests/.visual/
tests/debug.log
