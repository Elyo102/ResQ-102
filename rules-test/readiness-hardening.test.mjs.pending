head('L2 — shift_log');
const logDoc = (name, extra) => Object.assign({ text: 'הודעה', kind: 'chat', by_uid: 'h_tl', by_name: name, by_role: 'team_leader', by_crew: 'א', by_vehicle: '', hidden: false, created_key: '2026-09-25T00:00:00.000Z', created_at: serverTimestamp() }, extra || {});
await blocked('L2 shift_log with forged by_name', addDoc(collection(tl, `stations/${SID}/shift_log`), logDoc('מפקד התחנה')));
await blocked('L2 shift_log with forged by_role', addDoc(collection(tl, `stations/${SID}/shift_log`), logDoc('מפקד צוות', { by_role: 'station_commander' })));
await blocked('L2 shift_log pre-hidden / extra field', addDoc(collection(tl, `stations/${SID}/shift_log`), logDoc('מפקד צוות', { hidden: true, junk: big(5000) })));
await ok('L2 legit shift_log (messageDoc shape)', addDoc(collection(tl, `stations/${SID}/shift_log`), logDoc('מפקד צוות')));

head('L2 — handovers (faults.html writer shape, file untouched)');
const ho = (name, extra) => Object.assign({ crew: 'א', date: '2026-09-25', from_uid: 'h_cmdb', from_name: 'מפקד ב', to_uid: 'h_cmda', to_name: name, assessment: 'תקין', accepted_key: '2026-09-25T06:00:00.000Z', accepted_at: serverTimestamp() }, extra || {});
await blocked('L2 handover signed under another name', setDoc(doc(cmdA, `stations/${SID}/handovers/ho1`), ho('מפקד התחנה')));
await blocked('L2 handover with smuggled field', setDoc(doc(cmdA, `stations/${SID}/handovers/ho2`), ho('מפקד א', { approved: true })));
await ok('L2 legit handover', setDoc(doc(cmdA, `stations/${SID}/handovers/ho3`), ho('מפקד א')));

head('L2 — audit & documents');
await blocked('L2 staff deletes security_events audit record', deleteDoc(doc(depA, `stations/${SID}/security_events/e1`)));
await blocked('L2 staff forges security_events', setDoc(doc(depA, `stations/${SID}/security_events/e2`), { kind: 'forged' }));
await blocked('L2 member writes arbitrary 900KB documents record', setDoc(doc(ff, `stations/${SID}/documents/d1`), { emp_number: '1101', blob: big(900000) }));

head('L2 — shifts assignment shape');
await blocked('L2 staff writes shifts doc with forged by', setDoc(doc(cmdA, `stations/${SID}/shifts/א`), { assign: {}, updated_at: serverTimestamp(), by: 'h_st' }, { merge: true }));
await ok('L2 staff still writes a sub-document under shifts/{crew}', setDoc(doc(cmdA, `stations/${SID}/shifts/א/days/2026-09-25`), { note: 'x' }));
await ok('L2 legit saveAssign shape', setDoc(doc(cmdA, `stations/${SID}/shifts/א`), { assign: { v1: ['h_ff'] }, updated_at: serverTimestamp(), by: 'h_cmda' }, { merge: true }));

await env.cleanup();
console.log('\n' + (fail === 0 ? '✓ readiness-hardening: all ' + pass + ' passed' : '✗ readiness-hardening: ' + fail + ' failed · ' + pass + ' passed'));
failures.forEach((f) => console.log('    ' + f));
process.exit(fail === 0 ? 0 : 1);
